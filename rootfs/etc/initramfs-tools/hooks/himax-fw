#!/bin/sh
# initramfs-tools hook: the Himax HX83102J has no flash, its firmware is
# loaded from a file when the driver probes, which happens in the initramfs.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
for f in /lib/firmware/himax_i2chid_*.bin; do
	[ -e "$f" ] && add_firmware "$(basename "$f")"
done
exit 0
